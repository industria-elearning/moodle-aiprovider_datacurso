<div class="aiprovider-datacurso-rolelimits" data-region="aiprovider-datacurso-rolelimits">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="#" class="btn btn-primary" data-action="openadd">{{#str}} roletokenlimit_add, aiprovider_datacurso {{/str}}</a>
        <form method="get" action="{{searchaction}}" class="form-inline ml-2">
            <label for="id_search_roles" class="sr-only">{{#str}} search {{/str}}</label>
            <input type="text" id="id_search_roles" name="search" value="{{searchvalue}}" class="form-control" placeholder="{{#str}} search {{/str}}">
            <input type="hidden" name="sort" value="{{sort}}">
            <input type="hidden" name="dir" value="{{dir}}">
            <input type="hidden" name="perpage" value="{{perpage}}">
            <button type="submit" class="btn btn-secondary ml-2">{{#str}} search {{/str}}</button>
        </form>
    </div>

    <table class="generaltable">
        <thead>
            <tr>
                {{#columns}}
                    <th>
                        {{#sorturl}}
                            <a href="{{sorturl}}">
                                {{label}}
                                {{#current}}
                                    {{#dirasc}}
                                        <i class="icon fa fa-arrow-up-short-wide fa-fw" aria-hidden="true"></i>
                                    {{/dirasc}}
                                    {{#dirdesc}}
                                        <i class="icon fa fa-arrow-down-wide-short fa-fw" aria-hidden="true"></i>
                                    {{/dirdesc}}
                                {{/current}}
                            </a>
                        {{/sorturl}}
                        {{^sorturl}}{{label}}{{/sorturl}}
                    </th>
                {{/columns}}
            </tr>
        </thead>
        <tbody>
            {{#empty}}
                <tr><td colspan="7">{{nothingtodisplay}}</td></tr>
            {{/empty}}
            {{^empty}}
                {{#rows}}
                    <tr>
                        <td>{{rolename}}</td>
                        <td>{{roleshortname}}</td>
                        <td>{{priority}}</td>
                        <td>{{tokenlimit}}</td>
                        <td>{{tokensused}}</td>
                        <td>{{tokensavailable}}</td>
                        <td>
                            <a href="#" class="action-icon" data-action="openedit" data-id="{{id}}" data-rolename="{{rolename}}" title="{{#str}} edit {{/str}}">
                                {{#pix}} t/edit, core, {{#str}} edit {{/str}} {{/pix}}
                            </a>
                            {{#canreset}}
                                <a href="#" class="action-icon ml-1" data-action="resetusage" data-id="{{id}}" data-rolename="{{rolename}}" title="{{#str}} usertokenlimit_reset_usage, aiprovider_datacurso {{/str}}">
                                    {{#pix}} i/reload, core, {{#str}} usertokenlimit_reset_usage, aiprovider_datacurso {{/str}} {{/pix}}
                                </a>
                            {{/canreset}}
                            <a href="#" class="action-icon ml-1" data-action="delete" data-id="{{id}}" data-rolename="{{rolename}}" title="{{#str}} delete {{/str}}">
                                {{#pix}} t/delete, core, {{#str}} delete {{/str}} {{/pix}}
                            </a>
                        </td>
                    </tr>
                {{/rows}}
            {{/empty}}
        </tbody>
    </table>

    <div class="paging">
        {{{pagingbar}}}
    </div>
</div>
